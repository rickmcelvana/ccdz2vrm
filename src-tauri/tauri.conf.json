{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ccdz2vrm",
  "version": "0.1.0",
  "identifier": "com.latentpresence.ccdz2vrm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daz & Character Creator to VRM",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "latentPresence",
    "license": "GPL-3.0-or-later",
    "homepage": "https://latentpresence.com",
    "category": "GraphicsAndDesign",
    "shortDescription": "Turn Daz 3D and Character Creator characters into VRM avatars",
    "resources": {
      "../src/blender/*.py": "pipeline/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
